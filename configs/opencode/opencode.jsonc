{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "browse",
          "mcp"
        ],
        "cwd": "{env:HOME}",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
