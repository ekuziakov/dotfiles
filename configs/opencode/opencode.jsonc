{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/Users/egor/.local/bin/browse",
          "mcp"
        ],
        "cwd": "/Users/egor",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}